# ==============================================================================
# RAG System Environment Configuration Template
# Copy this file to .env and fill in your values if needed:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# Options: "huggingface" (100% Free & Local) | "openai" (Cloud API) | "ollama"
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Options: "ollama" (100% Free & Local) | "openai" (Cloud API)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# OpenAI API Settings (Only required if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# RAG Hyperparameters
# ------------------------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=3
LLM_TEMPERATURE=0.0

